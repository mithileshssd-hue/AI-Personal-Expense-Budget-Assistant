{
  "name": "smartfinance-app",
  "version": "2.0.0",
  "description": "SmartFinance AI Personal Expense & Budget Assistant Multi-User Web & Mobile Application",
  "scripts": {
    "build": "node build_www.js",
    "start": "python -m http.server 5500 --bind 127.0.0.1",
    "serve": "python -m http.server 5500 --bind 127.0.0.1",
    "dev": "python -m http.server 5500 --bind 127.0.0.1",
    "start:all": "start_server.bat",
    "worker:dev": "node node_modules/wrangler/bin/wrangler.js dev --port 8787",
    "worker:deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute DB --local --file=./migrations/0001_initial.sql",
    "db:migrate:prod": "wrangler d1 execute DB --remote --file=./migrations/0001_initial.sql",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android"
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "wrangler": "^3.114.17"
  }
}
